# ---------------------------------------------------------------------------
# PharmaChain environment template.
# Copy to .env and fill in real values. NEVER commit real secrets:
# .env is gitignored; this file stays placeholder-only.
# ---------------------------------------------------------------------------

# ----------------------------- Server --------------------------------------
PORT=41837
NODE_ENV=development

# ----------------------------- Database ------------------------------------
# MongoDB Atlas connection string (backend-only; never exposed to the browser)
PHARMACHAIN_MONGODB_URI=

# ------------------------- JWT authentication ------------------------------
# Long random string (e.g. `openssl rand -hex 48`). REQUIRED in production —
# the server refuses to boot without it when NODE_ENV=production.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------------------- AI prescription analysis ---------------------------
# All AI keys are BACKEND-ONLY. Never set them as VITE_ variables.
# PHARMACHAIN_AI_PROVIDER: none | huggingface | openai | openai-compatible
PHARMACHAIN_AI_PROVIDER=openai-compatible
OPENAI_BASE_URL=
OPENAI_API_KEY=
#OPENAI_MODEL=

# Hugging Face Inference Providers (server-side only)
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# Google Gemini (multi-AI provider). Paste ONLY the key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# OpenAI GPT-5 (multi-AI provider)
GPT5_API_KEY=

# --------------------- Polygon Amoy testnet --------------------------------
# Backend-only. The private key must NEVER leave the server.
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_EXPLORER_URL=https://amoy.polygonscan.com

# ------------------------------- ML ----------------------------------------
# Writes ONE labeled row (features + pharmacist ground truth) to
# server/ml/training-data/ per confirmed prescription. Local/server only.
ML_TRAINING_CAPTURE=false
# Path to a trained Random Forest artifact from scripts/train-random-forest.cjs.
# Unset = deterministic comparison engine stays authoritative.
# RANDOM_FOREST_MODEL_PATH=

# --------------------------- File storage ----------------------------------
# Encrypted prescription image storage root (server-local).
PHARMACHAIN_FILE_STORAGE_DIR=.data/files

# --------------------------- CORS (backend) --------------------------------
# Comma-separated allowed browser origins. Leave default for local dev.
# CORS_ORIGINS=https://your-app.vercel.app

# ------------------------ Frontend (Vercel) --------------------------------
# Public base URL of the BACKEND API, e.g. https://pharmachain-api.onrender.com
# Local dev leaves it unset (Vite proxy handles /api).
VITE_API_URL=
# Feature flags (never hold secrets here)
VITE_USE_BACKEND_AUTH=true
VITE_PRESCRIPTION_BACKEND_ENABLED=true
