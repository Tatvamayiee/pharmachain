{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:unused": "vite --port 5176 --strictPort",
    "dev:server": "node server/index.cjs",
    "dev:server:unused": "node scripts/dev/dev-server-unused.mjs",
    "deploy:registry": "node scripts/deploy/deploy-registry.cjs",
    "import:medicine-master": "node scripts/data/import-medicine-master.cjs",
    "test:backend": "node scripts/tests/verify-backend.mjs",
    "test:security": "node scripts/tests/security-battery.cjs",
    "test:gridfs": "node scripts/tests/verify-gridfs-storage.cjs",
    "test:e2e:hf": "node scripts/tests/live-e2e-hf-test.cjs",
    "build": "vite build",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && .\\gradlew.bat assembleDebug",
    "android:release": "npm run android:sync && cd android && .\\gradlew.bat assembleRelease bundleRelease",
    "build:app": "vite build && electron electron/main.cjs",
    "app": "electron electron/main.cjs",
    "dist": "vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "seed": "node server/seed/seed-db.cjs",
    "demo:seed": "node scripts/demo/seed-review-demo.cjs"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.pharmachain.app",
    "productName": "PharmaChain",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512x512.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icons/icon-512x512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icons/icon-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PharmaChain"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.57.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^12.43.0",
    "helmet": "^8.0.0",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.344.0",
    "mongoose": "^8.12.1",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "sha256-file": "^1.0.0",
    "web3": "^4.16.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "puppeteer": "^25.15.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "allowScripts": {
    "puppeteer@25.15.0": true,
    "esbuild@0.21.5": true
  }
}
