server-log.txt
tmp/
temp/
*.sw?

# ---------------------------------------------------------------------------
# Server-side data (never leave this machine / server)
# ---------------------------------------------------------------------------
# Encrypted prescription image storage
.data/
server/uploads/

# ML training rows (pharmacist labels) and trained model artifacts
server/ml/training-data/*
!server/ml/training-data/.gitkeep
server/ml/models/*
!server/ml/models/.gitkeep

# Raw reference dataset + built master (31.8 MB CSV / 123 MB JSON).
# Recreate with: npm run import:medicine-master
server/ml/reference/*.csv
server/ml/reference/*.json

# ---------------------------------------------------------------------------
# Local datasets (too large for Git; not required at runtime)
# ---------------------------------------------------------------------------
*.csv
*.zip
Doctor’s Handwritten Prescription BD dataset/

